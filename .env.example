# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Only the live-model experiments and `python -m coach.cli --live` read these.
# Everything in results/phase2/experiments_test.json, e4_g3_transfer.json and
# failure_analysis.json runs offline and needs none of this.

GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b
