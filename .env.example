# TrajectoryCoach — environment variables
# Copy this file to .env and fill in your keys.
# Never commit the real .env file — it is listed in .gitignore.

# Groq API key (required for E4/G2 LLM experiments and live CLI --groq mode)
GROQ_API_KEY=gsk_your_key_here

# OpenAI key (optional; kept from Phase 1 for reference)
OPENAI_API_KEY=sk_your_key_here
OPENAI_MODEL=gpt-4o

# Groq model override (optional; default is llama3-8b-8192)
# GROQ_MODEL=llama3-70b-8192

