{
  "_comment": "Fixed experiment configuration for Phase 2. Every setting that produced a reported number traces back to this file.",
  "split_rule": "index % 3 == 2 -> test",
  "test_learner_ids": ["2", "5", "8", "11", "14", "17", "20", "23"],
  "dev_learner_ids": ["0", "1", "3", "4", "6", "7", "9", "10", "12", "13", "15", "16", "18", "19", "21", "22"],
  "data": "data/zenodo_24_students.csv.gz",

  "policy": {
    "window_seconds": 300,
    "cooldown": 180,
    "max_prompts": 3,
    "run_threshold": 3
  },

  "g1_timing_gate": {
    "gate_seconds": 45,
    "pause_horizon": 300,
    "burst_threshold": 15
  },

  "g2_grounding": {
    "min_evidence": 5,
    "thin_evidence_threshold": 5
  },

  "g3_transfer": {
    "n_learners": 120,
    "n_tasks": 6,
    "latent_skill_range": [0.3, 0.9]
  },

  "baselines": {
    "aims_request_rate": 0.5077,
    "aims_source": "725 hints / 102 students / 14 questions from Phung et al. 2025"
  },

  "stochastic": {
    "seeds": [0, 1, 2],
    "bootstrap_n": 1000,
    "bootstrap_seed": 0,
    "transfer_seeds": [0, 1, 2, 3, 4]
  },

  "llm": {
    "temperature": 0,
    "groq_model": "llama3-8b-8192",
    "max_tool_rounds": 3,
    "max_api_calls": 10
  },

  "ablation_variants": [
    {"name": "full_system",       "desc": "Full system (E3)"},
    {"name": "no_cooldown",       "desc": "No cooldown"},
    {"name": "no_budget",         "desc": "No episode budget"},
    {"name": "no_response_wait",  "desc": "No response wait"},
    {"name": "no_evidence_floor", "desc": "No evidence floor (G2 disabled)"},
    {"name": "no_timing_gate",    "desc": "No timing gate (G1 disabled)"},
    {"name": "phase1_policy",     "desc": "Phase 1 policy (original defaults)"}
  ]
}

