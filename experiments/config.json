{
  "split": {
    "file": "data/splits.json",
    "rule": "learners sorted by integer id; every third learner (index % 3 == 2) is test",
    "dev_learners": 16, "test_learners": 8,
    "test_only_for": "reported results", "dev_only_for": "all design decisions"
  },
  "policy_defaults": {
    "window_seconds": 300, "cooldown": 180, "max_prompts": 3,
    "run_threshold": 3, "gate_seconds": 20, "gate_horizon": 600, "min_evidence": 5
  },
  "metric_constants": {
    "burst_seconds": 5, "pause_seconds": 20, "coverage_tolerance_seconds": 30,
    "behaviour_window_seconds": 300, "min_actions_for_behaviour_window": 5,
    "bootstrap_replicates": 1000, "bootstrap_unit": "learner"
  },
  "experiments": {
    "E1": {"what": "uncapped rule baseline", "script": "scripts/run_experiments.py",
           "config": {"mode": "rule"}, "seeds": [0]},
    "E2": {"what": "base paper on-demand policy, our adaptation",
           "script": "scripts/run_experiments.py",
           "config": {"request_models": ["pause", "stuck", "uniform"],
                      "rate_per_student_question": 0.5077,
                      "rate_source": "Phung et al. 2025: 725 hints / (102 students x 14 questions)"},
           "seeds": [0, 1, 2], "headline": "pause"},
    "E3": {"what": "full proposed system", "script": "scripts/run_experiments.py",
           "config": {"mode": "adaptive", "gate_seconds": 20, "min_evidence": 5},
           "seeds": [0]},
    "E4": {"what": "one experiment per gap",
           "G1": "scripts/run_experiments.py (timing measures)",
           "G2": "scripts/run_llm_experiments.py (constrained vs unconstrained)",
           "G3": "scripts/run_transfer_study.py (simulated learners, 5 seeds)"},
    "E5": {"what": "ablation, one component removed at a time",
           "script": "scripts/run_experiments.py",
           "variants": ["no_timing_gate", "no_evidence_floor", "no_cooldown",
                        "no_budget", "no_memory", "none_phase1"]},
    "E6": {"what": "efficiency and reliability",
           "offline": "runtime, events per second, peak memory, scaffolds per 1000 events",
           "live": "API calls, tokens, latency, tool calls, validator rejection rate"}
  },
  "live_model": {
    "endpoint": "https://api.groq.com/openai/v1/chat/completions",
    "model_env": "GROQ_MODEL", "key_env": "GROQ_API_KEY",
    "temperature": 0.0, "seed": 0, "max_tokens": 400,
    "tool_call_budget_per_decision": 6
  }
}
